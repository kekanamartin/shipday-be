# ============================================
# SwiftShip Backend Environment Configuration
# ============================================

# Environment Mode
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================
# Local Development
MONGO_URI=mongodb://localhost:27017/swiftship

# Production (MongoDB Atlas or Azure Cosmos DB)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/swiftship?retryWrites=true&w=majority

# ============================================
# Server Configuration
# ============================================
PORT=5000

# ============================================
# JWT Secret
# ============================================
# Use a strong, random secret for production
JWT_SECRET=your_jwt_secret_here_change_this_in_production

# ============================================
# Email Configuration (for notifications)
# ============================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ============================================
# Firebase Configuration (for push notifications)
# ============================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# ============================================
# PayFast Payment Gateway Configuration
# ============================================
# Mode: 'sandbox' for testing, 'live' for production
PAYFAST_MODE=sandbox

# Sandbox Credentials (for testing)
PAYFAST_MERCHANT_ID=10044381
PAYFAST_MERCHANT_KEY=rdpy6ewl5duej
PAYFAST_PASSPHRASE=null

# Production Credentials (uncomment and use in production)
# PAYFAST_MERCHANT_ID=your_production_merchant_id
# PAYFAST_MERCHANT_KEY=your_production_merchant_key
# PAYFAST_PASSPHRASE=your_production_passphrase

# ============================================
# URL Configuration (for PayFast callbacks)
# ============================================
# BASE_URL = the frontend's address (PayFast sends customers back here)
# API_URL  = the backend's address INCLUDING /api (PayFast payment notifications go to API_URL/payments/notify)
# Local Development
BASE_URL=http://localhost:5173
API_URL=http://localhost:5000/api

# Production URLs (uncomment for production)
# BASE_URL=https://lemon-moss-0af8f730f.1.azurestaticapps.net
# API_URL=https://swiftship-be-bxcwgcbzauhuekas.canadacentral-01.azurewebsites.net/api

# ============================================
# Deployment / Vercel
# ============================================
# The frontend's address: allowed by CORS and used in emails (no trailing slash)
FRONTEND_URL=http://localhost:5173
# Extra allowed origins, comma-separated. "*" matches one part of a host name, e.g. Vercel previews:
# CORS_ORIGINS=https://shipday-frontend-*.vercel.app
# Where uploads are stored: "disk" (uploads/ folder) or "inline" (inside the database record).
# Defaults to inline on Vercel, whose file system is read-only, and disk everywhere else.
# FILE_STORAGE=disk

# ============================================
# Optional: Additional Configuration
# ============================================
# Add any other environment-specific variables here

# ============================================
# The Courier Guy / ShipLogic (sandbox by default)
# Obtain a sandbox API key from The Courier Guy's ShipLogic portal.
COURIER_TCG_BASE_URL=https://api.shiplogic.com
COURIER_TCG_API_KEY=
COURIER_TCG_AUTH_SCHEME=Token
# Optional account-specific rate lookup:
# COURIER_TCG_ACCOUNT_ID=123